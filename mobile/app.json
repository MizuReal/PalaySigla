{
  "expo": {
    "name": "PalaySigla",
    "slug": "palaysigla",
    "scheme": "palaysigla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PalaySigla uses your photos so you can add a picture to your listing.",
          "cameraPermission": "PalaySigla uses the camera so you can photograph the item you are selling.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
