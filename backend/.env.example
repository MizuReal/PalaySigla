# FastAPI
APP_NAME=PalaySigla
APP_VERSION=0.1.0
CONTACT_EMAIL=dev@palaysigla.ph
CORS_ORIGINS=http://localhost:5173

# Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_MIN_INTERVAL_SECONDS=1.0
GEOCODE_CACHE_TTL_SECONDS=86400
GEOCODE_REQUEST_TIMEOUT_SECONDS=5.0

# Per-IP API rate limit
IP_RATE_LIMIT_MAX_REQUESTS=10
IP_RATE_LIMIT_WINDOW_SECONDS=10

# Supabase (server-side auth: JWT validation via the service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alias accepted for the same value: SUPABASE_SECRET_KEY

# Palay Assistant (Groq-hosted openai/gpt-oss-20b)
GROQ_CHATBOT_API_KEY=
GROQ_CHATBOT_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHATBOT_MODEL=openai/gpt-oss-20b
CHAT_MAX_TOKENS=512
CHAT_REQUEST_TIMEOUT_SECONDS=20
CHAT_HISTORY_MAX_MESSAGES=20

# Per-IP chat rate limit (stricter than geocode: LLM calls cost money)
CHAT_RATE_LIMIT_MAX_REQUESTS=6
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Scan OCR
# OCR_TEMPLATES_DIR empty means the repo-root ocr_templates/ folder.
OCR_TEMPLATES_DIR=
# Required: the app fails fast at boot without this artifact. Train it with
#   .venv/bin/python scripts/train_digit_model.py --output models/scan_digit.onnx
SCAN_DIGIT_MODEL_PATH=
SCAN_DIGIT_MODEL_SHA256=
SCAN_DIGIT_CONFIDENCE_THRESHOLD=0.80
SCAN_RATIO_MISMATCH_TOLERANCE=0.05
SCAN_MAX_IMAGE_BYTES=10485760
SCAN_INFERENCE_MAX_WORKERS=2
SCAN_RATE_LIMIT_MAX_REQUESTS=10
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
